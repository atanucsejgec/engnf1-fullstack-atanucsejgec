# Postgres connection string (Neon in production, local Docker in development)
DATABASE_URL=postgres://user:password@localhost:5432/triagesync
# Secret used to sign login tokens - use a long random string
JWT_SECRET=change-me-to-a-long-random-string
# Port the API listens on
PORT=4000
# Frontend URL allowed by CORS (comma separated if more than one)
CORS_ORIGIN=http://localhost:5173
